{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webhook-tester",
	"main": "src/index.js",
	"compatibility_date": "2025-07-03",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "dffa73327fbd08316787eb03c1afc673",
	"observability": {
		"enabled": true,
	},
	// Public dashboard origin: OAuth redirect_uri, post-login redirect, CSRF origin check and CORS.
	// Secrets (not in this file): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET via `wrangler secret put`.
	"vars": {
		"APP_URL": "https://webhooks.procd.cc",
		// Comma-separated verified GitHub emails with access to the admin view.
		"ADMIN_EMAILS": "ayush2162002@gmail.com",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "webhook-db",
			"database_id": "51927eba-bc8c-4d11-9ae2-5b944f13ffd2",
			"migrations_dir": "migrations",
		},
	],
	// Per-user realtime hub fanning out Server-Sent Events (src/realtime/hub.js).
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RealtimeHub"],
		},
	],
	"kv_namespaces": [
		{
			"binding": "WEBHOOK_CACHE",
			"id": "84c66c4a1b1344159213ac77e4f1e53b",
		},
	],
	"routes": [
		{
			"pattern": "hooks.procd.cc",
			"custom_domain": true,
		},
	],
}
